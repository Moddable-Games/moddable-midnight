{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@contract": [
        "../src/managed/tournament_pass/contract/index.d.ts"
      ],
      "@crew": [
        "../src/managed/crew_treasury/contract/index.d.ts"
      ],
      "@native-unshielded": [
        "../src/managed/native_unshielded/contract/index.d.ts"
      ],
      "@native-shielded": [
        "../src/managed/native_shielded/contract/index.d.ts"
      ],
      "@contract-token": [
        "../src/managed/contract_token/contract/index.d.ts"
      ],
      "@private-ledger": [
        "../src/managed/private_ledger/contract/index.d.ts"
      ],
      "@crew-v3": [
        "../src/managed/crew_treasury_v3/contract/index.d.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
